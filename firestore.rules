rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isVerifiedUser() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function isPermitAdmin() {
      return isVerifiedUser()
        && request.auth.token.email in ["gerlieantipaso27@gmail.com", "rjamescute2@gmail.com"];
    }
    function isAccomplishmentReportEditable(report) {
      let manilaNow = request.time + duration.value(8, "h");
      let currentMonth = string(manilaNow.year()) + "-" + (manilaNow.month() < 10 ? "0" + string(manilaNow.month()) : string(manilaNow.month()));
      let previousMonth = manilaNow.month() == 1
        ? string(manilaNow.year() - 1) + "-12"
        : string(manilaNow.year()) + "-" + (manilaNow.month() - 1 < 10 ? "0" + string(manilaNow.month() - 1) : string(manilaNow.month() - 1));
      return report.month is string
        && report.month.matches("[0-9]{4}-(0[1-9]|1[0-2])")
        && ((report.cycle == 1
            && (currentMonth < report.month
              || (currentMonth == report.month && manilaNow.day() < 21)))
          || (report.cycle == 2
            && (currentMonth <= report.month
              || (previousMonth == report.month && manilaNow.day() < 6))));
    }
    match /users/{userId} {
      // All verified users can read profiles to populate personnel dropdowns.
      allow read: if isVerifiedUser();
      // New accounts must save their profile before email verification; only the same UID can write it.
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasAll(["name", "position", "unit"])
        && request.resource.data.keys().hasOnly(["name", "position", "unit", "firstName", "middleName", "lastName", "gender"])
        && (!request.resource.data.keys().hasAny(["gender"]) || request.resource.data.gender in ["Male", "Female"])
        && (!request.resource.data.keys().hasAny(["firstName"]) || (request.resource.data.firstName is string && request.resource.data.firstName.size() <= 60))
        && (!request.resource.data.keys().hasAny(["middleName"]) || (request.resource.data.middleName is string && request.resource.data.middleName.size() <= 60))
        && (!request.resource.data.keys().hasAny(["lastName"]) || (request.resource.data.lastName is string && request.resource.data.lastName.size() <= 60))
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.position is string
        && request.resource.data.position.size() <= 120
        && request.resource.data.unit in ["AMIA", "AGRISTAT", "DRRM"];
      allow delete: if false;
    }
    match /chats/{chatId} {
      allow read: if isVerifiedUser() && request.auth.uid in resource.data.members;
      allow create: if isVerifiedUser()
        && request.resource.data.keys().hasOnly(["members", "lastText", "lastSenderId", "lastAt", "readAt"])
        && request.resource.data.members is list
        && request.resource.data.members.size() == 2
        && request.auth.uid in request.resource.data.members
        && chatId == request.resource.data.members[0] + "_" + request.resource.data.members[1]
        && request.resource.data.lastSenderId == request.auth.uid
        && request.resource.data.lastText is string
        && request.resource.data.lastText.size() <= 200;
      allow update: if isVerifiedUser()
        && request.auth.uid in resource.data.members
        && request.resource.data.members == resource.data.members
        && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(["readAt", "clearedAt"])
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(["lastText", "lastSenderId", "lastAt", "readAt"])
            && request.resource.data.lastSenderId == request.auth.uid
            && request.resource.data.lastText is string
            && request.resource.data.lastText.size() <= 200));
      allow delete: if false;
      match /hidden/{userId} {
        allow read, delete: if isVerifiedUser()
          && request.auth.uid == userId
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
        allow create, update: if isVerifiedUser()
          && request.auth.uid == userId
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members
          && request.resource.data.keys().hasOnly(["ids"])
          && request.resource.data.ids is list
          && request.resource.data.ids.size() <= 500;
      }
      match /messages/{messageId} {
        allow read: if isVerifiedUser()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
        allow create: if isVerifiedUser()
          && request.auth.uid in getAfter(/databases/$(database)/documents/chats/$(chatId)).data.members
          && request.resource.data.keys().hasOnly(["senderId", "kind", "text", "createdAt", "replyTo"])
          && (!request.resource.data.keys().hasAny(["replyTo"])
            || (request.resource.data.replyTo is map
              && request.resource.data.replyTo.keys().hasOnly(["id", "senderId", "kind", "text"])
              && request.resource.data.replyTo.text is string
              && request.resource.data.replyTo.text.size() <= 200))
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.kind in ["text", "sticker", "gif"]
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && (request.resource.data.kind != "gif" || request.resource.data.text.matches("^https://[^ ]+$"))
          && request.resource.data.createdAt == request.time;
        allow update: if isVerifiedUser()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members
          && ((resource.data.senderId == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["deleted", "text", "kind"])
              && request.resource.data.deleted == true
              && request.resource.data.kind == "text"
              && request.resource.data.text == "")
            || (resource.data.get("deleted", false) == false
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["reactions"])
              && request.resource.data.reactions is map
              && request.resource.data.reactions.diff(resource.data.get("reactions", {})).affectedKeys().hasOnly([request.auth.uid])
              && (!(request.auth.uid in request.resource.data.reactions)
                || request.resource.data.reactions[request.auth.uid] in ["heart", "like", "wow", "sad", "angry"])));
        allow delete: if false;
      }
    }
    match /calendarOfActivities/{calendarId} {
      allow read: if isVerifiedUser() && (resource.data.ownerId == request.auth.uid
        || resource.data.status == "Approved");
      allow create: if isVerifiedUser()
        && request.resource.data.keys().hasAll(["ownerId", "unit", "month", "status", "activities", "preparedName", "preparedPosition", "createdAt"])
        && request.resource.data.keys().hasOnly(["ownerId", "unit", "month", "status", "activities", "preparedName", "preparedPosition", "createdAt"])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.unit in ["AMIA", "AGRISTAT", "DRRM"]
        && request.resource.data.month is string
        && request.resource.data.month.matches("^[0-9]{4}-(0[1-9]|1[0-2])$")
        && request.resource.data.status in ["Pending", "Approved"]
        && request.resource.data.activities is list
        && request.resource.data.activities.size() > 0
        && request.resource.data.activities.size() <= 100
        && request.resource.data.preparedName is string
        && request.resource.data.preparedName.size() > 0
        && request.resource.data.preparedName.size() <= 120
        && request.resource.data.preparedPosition is string
        && request.resource.data.preparedPosition.size() > 0
        && request.resource.data.preparedPosition.size() <= 120
        && request.resource.data.createdAt is timestamp;
      allow update: if isVerifiedUser()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.diff(resource.data).affectedKeys().hasAny(["activities", "status"])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["activities", "status"])
        && (!request.resource.data.keys().hasAny(["status"])
          || request.resource.data.status in ["Pending", "Approved"])
        && request.resource.data.activities is list
        && request.resource.data.activities.size() > 0
        && request.resource.data.activities.size() <= 100;
      allow delete: if isVerifiedUser() && resource.data.ownerId == request.auth.uid;
    }
    match /calendarActivityApprovalNotifications/{notificationId} {
      function calendarPath(calendarId) {
        return /databases/$(database)/documents/calendarOfActivities/$(calendarId);
      }
      allow read: if isVerifiedUser() && isPermitAdmin();
      allow create: if isVerifiedUser()
        && request.resource.data.keys().hasAll(["calendarId", "ownerId", "unit", "month", "preparedName", "status", "readBy", "createdAt"])
        && request.resource.data.keys().hasOnly(["calendarId", "ownerId", "unit", "month", "preparedName", "status", "readBy", "createdAt"])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.calendarId is string
        && exists(calendarPath(request.resource.data.calendarId))
        && get(calendarPath(request.resource.data.calendarId)).data.ownerId == request.auth.uid
        && (!get(calendarPath(request.resource.data.calendarId)).data.keys().hasAny(["status"])
          || get(calendarPath(request.resource.data.calendarId)).data.status == "Pending")
        && getAfter(calendarPath(request.resource.data.calendarId)).data.ownerId == request.auth.uid
        && getAfter(calendarPath(request.resource.data.calendarId)).data.status == "Approved"
        && getAfter(calendarPath(request.resource.data.calendarId)).data.unit == request.resource.data.unit
        && getAfter(calendarPath(request.resource.data.calendarId)).data.month == request.resource.data.month
        && getAfter(calendarPath(request.resource.data.calendarId)).data.preparedName == request.resource.data.preparedName
        && request.resource.data.unit in ["AMIA", "AGRISTAT", "DRRM"]
        && request.resource.data.month is string
        && request.resource.data.preparedName is string
        && request.resource.data.preparedName.size() > 0
        && request.resource.data.status == "Approved"
        && request.resource.data.readBy is list
        && request.resource.data.readBy.size() == 0
        && request.resource.data.createdAt is timestamp;
      allow update: if isVerifiedUser()
        && isPermitAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["readBy"])
        && resource.data.readBy is list
        && request.resource.data.readBy is list
        && request.resource.data.readBy.hasAll(resource.data.readBy)
        && request.auth.uid in request.resource.data.readBy;
      allow delete: if false;
    }
    match /calendarActivityNotifications/{notificationId} {
      allow read: if isVerifiedUser() && (resource.data.recipientId == request.auth.uid || resource.data.ownerId == request.auth.uid);
      allow create: if isVerifiedUser()
        && request.resource.data.keys().hasAll(["recipientId", "ownerId", "calendarId", "unit", "month", "activities", "read", "createdAt"])
        && request.resource.data.keys().hasOnly(["recipientId", "ownerId", "calendarId", "unit", "month", "activities", "read", "createdAt"])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.recipientId is string
        && request.resource.data.recipientId != request.auth.uid
        && request.resource.data.unit in ["AMIA", "AGRISTAT", "DRRM"]
        && get(/databases/$(database)/documents/users/$(request.resource.data.recipientId)).data.unit == request.resource.data.unit
        && request.resource.data.calendarId is string
        && getAfter(/databases/$(database)/documents/calendarOfActivities/$(request.resource.data.calendarId)).data.ownerId == request.auth.uid
        && getAfter(/databases/$(database)/documents/calendarOfActivities/$(request.resource.data.calendarId)).data.unit == request.resource.data.unit
        && request.resource.data.month is string
        && getAfter(/databases/$(database)/documents/calendarOfActivities/$(request.resource.data.calendarId)).data.month == request.resource.data.month
        && request.resource.data.activities is list
        && request.resource.data.activities.size() > 0
        && request.resource.data.activities.size() <= 100
        && request.resource.data.read == false
        && request.resource.data.createdAt is timestamp;
      allow update: if isVerifiedUser() && (
        (resource.data.recipientId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["read", "readAt"])
          && request.resource.data.read == true
          && request.resource.data.readAt is timestamp)
        || (resource.data.ownerId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["month", "activities", "read", "readAt", "createdAt"])
          && request.resource.data.keys().hasAll(["recipientId", "ownerId", "calendarId", "unit", "month", "activities", "read", "createdAt"])
          && request.resource.data.keys().hasOnly(["recipientId", "ownerId", "calendarId", "unit", "month", "activities", "read", "createdAt"])
          && request.resource.data.recipientId == resource.data.recipientId
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.calendarId == resource.data.calendarId
          && request.resource.data.unit == resource.data.unit
          && request.resource.data.ownerId == request.auth.uid
          && resource.data.calendarId is string
          && getAfter(/databases/$(database)/documents/calendarOfActivities/$(resource.data.calendarId)).data.ownerId == request.auth.uid
          && getAfter(/databases/$(database)/documents/calendarOfActivities/$(resource.data.calendarId)).data.unit == request.resource.data.unit
          && getAfter(/databases/$(database)/documents/calendarOfActivities/$(resource.data.calendarId)).data.month == request.resource.data.month
          && request.resource.data.month is string
          && request.resource.data.activities is list
          && request.resource.data.activities.size() > 0
          && request.resource.data.activities.size() <= 100
          && request.resource.data.read == false
          && request.resource.data.createdAt is timestamp));
      allow delete: if isVerifiedUser() && resource.data.ownerId == request.auth.uid;
    }
    match /permits/{permitId} {
      allow read: if isVerifiedUser() && (resource.data.ownerId == request.auth.uid || isPermitAdmin());
      allow create: if isVerifiedUser()
        && request.resource.data.ownerId == request.auth.uid
        && !request.resource.data.keys().hasAny(["personStatuses"]);
      allow update: if isVerifiedUser() && (
        (resource.data.ownerId == request.auth.uid
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(["personStatuses"]))
        || (isPermitAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["personStatuses"])
          && request.resource.data.personStatuses is map)
      );
      allow delete: if isVerifiedUser() && resource.data.ownerId == request.auth.uid;
    }
    match /permitCounters/{counterId} {
      allow read, write: if isVerifiedUser();
    }
    match /approvedPermitCalendar/{entryId} {
      allow read: if isVerifiedUser();
      allow create, update: if isPermitAdmin()
        && request.resource.data.keys().hasAll(["permitId", "statusKey", "status", "permitNo", "name", "date", "purpose", "unit"])
        && request.resource.data.keys().hasOnly(["permitId", "statusKey", "status", "permitNo", "name", "date", "purpose", "unit"])
        && request.resource.data.permitId is string
        && request.resource.data.statusKey is string
        && request.resource.data.status == "Approved"
        && getAfter(/databases/$(database)/documents/permits/$(request.resource.data.permitId)).data.personStatuses[request.resource.data.statusKey].status == "Approved";
      allow delete: if isPermitAdmin() || (isVerifiedUser()
        && resource.data.permitId is string
        && get(/databases/$(database)/documents/permits/$(resource.data.permitId)).data.ownerId == request.auth.uid
        && !existsAfter(/databases/$(database)/documents/permits/$(resource.data.permitId)));
    }
    match /specialOrders/{orderId} {
      allow read: if isVerifiedUser() && resource.data.ownerId == request.auth.uid;
      allow create: if isVerifiedUser() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isVerifiedUser() && resource.data.ownerId == request.auth.uid;
    }
    match /certificatesOfAppearance/{certificateId} {
      allow read, update, delete: if isVerifiedUser() && resource.data.ownerId == request.auth.uid;
      allow create: if isVerifiedUser()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.keys().hasAll(["eventTitle", "destination", "eventDateFrom", "eventDateTo", "people", "signatoryName", "designation", "division", "ownerId", "createdAt"])
        && request.resource.data.keys().hasOnly(["eventTitle", "destination", "eventDateFrom", "eventDateTo", "people", "signatoryName", "designation", "division", "ownerId", "createdAt"])
        && request.resource.data.eventTitle is string
        && request.resource.data.destination is string
        && request.resource.data.eventDateFrom is string
        && request.resource.data.eventDateTo is string
        && request.resource.data.people is list
        && request.resource.data.people.size() > 0
        && request.resource.data.people.size() <= 100
        && request.resource.data.signatoryName is string
        && request.resource.data.designation is string
        && request.resource.data.division is string
        && request.resource.data.createdAt is timestamp;
    }
    match /appreciationCertificates/{certificateId} {
      allow read: if isVerifiedUser() && resource.data.ownerId == request.auth.uid;
      allow create: if isVerifiedUser()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.keys().hasAll(["unit", "speakerName", "speakerGender", "speakerPosition", "speakerOffice", "eventTitle", "eventDateFrom", "eventDateTo", "eventTimeFrom", "eventTimeTo", "eventDestination", "distributionSameAsDestination", "distributionPlace", "ownerId", "createdAt"])
        && request.resource.data.keys().hasOnly(["unit", "speakerName", "speakerGender", "speakerPosition", "speakerOffice", "speakers", "eventTitle", "eventDateFrom", "eventDateTo", "eventTimeFrom", "eventTimeTo", "eventDestination", "distributionSameAsDestination", "distributionPlace", "ownerId", "createdAt"])
        && request.resource.data.unit in ["AMIA", "DRRM"]
        && request.resource.data.speakerName is string
        && request.resource.data.speakerName.size() > 0
        && request.resource.data.speakerName.size() <= 180
        && request.resource.data.speakerGender in ["female", "male"]
        && request.resource.data.speakerPosition is string
        && request.resource.data.speakerPosition.size() > 0
        && request.resource.data.speakerPosition.size() <= 180
        && request.resource.data.speakerOffice is string
        && request.resource.data.speakerOffice.size() > 0
        && request.resource.data.speakerOffice.size() <= 240
        && request.resource.data.eventTitle is string
        && request.resource.data.eventTitle.size() > 0
        && request.resource.data.eventTitle.size() <= 240
        && request.resource.data.eventDateFrom is string
        && request.resource.data.eventDateFrom.size() > 0
        && request.resource.data.eventDateTo is string
        && request.resource.data.eventDateTo.size() > 0
        && request.resource.data.eventTimeFrom is string
        && request.resource.data.eventTimeFrom.size() > 0
        && request.resource.data.eventTimeTo is string
        && request.resource.data.eventTimeTo.size() > 0
        && request.resource.data.eventDestination is string
        && request.resource.data.eventDestination.size() > 0
        && request.resource.data.eventDestination.size() <= 240
        && request.resource.data.distributionSameAsDestination is bool
        && request.resource.data.distributionPlace is string
        && request.resource.data.distributionPlace.size() > 0
        && request.resource.data.distributionPlace.size() <= 240
        && (!request.resource.data.distributionSameAsDestination || request.resource.data.distributionPlace == request.resource.data.eventDestination)
        && (!request.resource.data.keys().hasAny(["speakers"])
          || (request.resource.data.speakers is list
            && request.resource.data.speakers.size() > 0
            && request.resource.data.speakers.size() <= 100
            && request.resource.data.speakers[0] is map
            && request.resource.data.speakers[0].name == request.resource.data.speakerName
            && request.resource.data.speakers[0].gender == request.resource.data.speakerGender
            && request.resource.data.speakers[0].position == request.resource.data.speakerPosition
            && request.resource.data.speakers[0].office == request.resource.data.speakerOffice))
        && request.resource.data.createdAt is timestamp;
      allow update: if isVerifiedUser()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["speakers", "speakerName", "speakerGender", "speakerPosition", "speakerOffice"])
        && request.resource.data.speakers is list
        && request.resource.data.speakers.size() > 0
        && request.resource.data.speakers.size() <= 100
        && request.resource.data.speakerName is string
        && request.resource.data.speakerName.size() > 0
        && request.resource.data.speakerName.size() <= 180
        && request.resource.data.speakerGender in ["female", "male"]
        && request.resource.data.speakerPosition is string
        && request.resource.data.speakerPosition.size() > 0
        && request.resource.data.speakerPosition.size() <= 180
        && request.resource.data.speakerOffice is string
        && request.resource.data.speakerOffice.size() > 0
        && request.resource.data.speakerOffice.size() <= 240
        && request.resource.data.speakers[0] is map
        && request.resource.data.speakers[0].name == request.resource.data.speakerName
        && request.resource.data.speakers[0].gender == request.resource.data.speakerGender
        && request.resource.data.speakers[0].position == request.resource.data.speakerPosition
        && request.resource.data.speakers[0].office == request.resource.data.speakerOffice;
      allow delete: if isVerifiedUser() && resource.data.ownerId == request.auth.uid;
    }
    match /completionCertificates/{certificateId} {
      allow read: if isVerifiedUser() && resource.data.ownerId == request.auth.uid;
      allow create: if isVerifiedUser()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.keys().hasAll(["unit", "participantNames", "eventTitle", "eventDateFrom", "eventDateTo", "eventTimeFrom", "eventTimeTo", "eventDestination", "distributionSameAsDestination", "distributionPlace", "ownerId", "createdAt"])
        && request.resource.data.keys().hasOnly(["unit", "participantNames", "eventTitle", "eventDateFrom", "eventDateTo", "eventTimeFrom", "eventTimeTo", "eventDestination", "distributionSameAsDestination", "distributionPlace", "ownerId", "createdAt"])
        && request.resource.data.unit in ["AMIA", "DRRM"]
        && request.resource.data.participantNames is list
        && request.resource.data.participantNames.size() > 0
        && request.resource.data.participantNames.size() <= 100
        && request.resource.data.eventTitle is string
        && request.resource.data.eventTitle.size() > 0
        && request.resource.data.eventTitle.size() <= 240
        && request.resource.data.eventDateFrom is string
        && request.resource.data.eventDateTo is string
        && request.resource.data.eventTimeFrom is string
        && request.resource.data.eventTimeTo is string
        && request.resource.data.eventDestination is string
        && request.resource.data.eventDestination.size() > 0
        && request.resource.data.eventDestination.size() <= 240
        && request.resource.data.distributionSameAsDestination is bool
        && request.resource.data.distributionPlace is string
        && request.resource.data.distributionPlace.size() > 0
        && request.resource.data.distributionPlace.size() <= 240
        && (!request.resource.data.distributionSameAsDestination || request.resource.data.distributionPlace == request.resource.data.eventDestination)
        && request.resource.data.createdAt is timestamp;
      allow update: if isVerifiedUser()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasAny(["participantNames"])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["participantNames"])
        && request.resource.data.participantNames is list
        && request.resource.data.participantNames.size() > 0
        && request.resource.data.participantNames.size() <= 100;
      allow delete: if isVerifiedUser() && resource.data.ownerId == request.auth.uid;
    }
    match /participationCertificates/{certificateId} {
      allow read: if isVerifiedUser() && resource.data.ownerId == request.auth.uid;
      allow create: if isVerifiedUser()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.keys().hasAll(["unit", "participantNames", "participantGenders", "eventTitle", "eventDateFrom", "eventDateTo", "eventTimeFrom", "eventTimeTo", "eventDestination", "distributionSameAsDestination", "distributionPlace", "ownerId", "createdAt"])
        && request.resource.data.keys().hasOnly(["unit", "participantNames", "participantGenders", "eventTitle", "eventDateFrom", "eventDateTo", "eventTimeFrom", "eventTimeTo", "eventDestination", "distributionSameAsDestination", "distributionPlace", "ownerId", "createdAt"])
        && request.resource.data.unit == "AMIA"
        && request.resource.data.participantNames is list
        && request.resource.data.participantNames.size() > 0
        && request.resource.data.participantNames.size() <= 100
        && request.resource.data.participantGenders is list
        && request.resource.data.participantGenders.size() == request.resource.data.participantNames.size()
        && request.resource.data.participantGenders.hasOnly(["female", "male"])
        && request.resource.data.eventTitle is string
        && request.resource.data.eventTitle.size() > 0
        && request.resource.data.eventTitle.size() <= 240
        && request.resource.data.eventDateFrom is string
        && request.resource.data.eventDateTo is string
        && request.resource.data.eventTimeFrom is string
        && request.resource.data.eventTimeTo is string
        && request.resource.data.eventDestination is string
        && request.resource.data.eventDestination.size() > 0
        && request.resource.data.eventDestination.size() <= 240
        && request.resource.data.distributionSameAsDestination is bool
        && request.resource.data.distributionPlace is string
        && request.resource.data.distributionPlace.size() > 0
        && request.resource.data.distributionPlace.size() <= 240
        && (!request.resource.data.distributionSameAsDestination || request.resource.data.distributionPlace == request.resource.data.eventDestination)
        && request.resource.data.createdAt is timestamp;
      allow update: if isVerifiedUser()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasAny(["participantNames", "participantGenders"])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["participantNames", "participantGenders"])
        && request.resource.data.participantNames is list
        && request.resource.data.participantNames.size() > 0
        && request.resource.data.participantNames.size() <= 100
        && request.resource.data.participantGenders is list
        && request.resource.data.participantGenders.size() == request.resource.data.participantNames.size()
        && request.resource.data.participantGenders.hasOnly(["female", "male"]);
      allow delete: if isVerifiedUser() && resource.data.ownerId == request.auth.uid;
    }
    match /leaveApplications/{leaveApplicationId} {
      allow read: if isVerifiedUser() && resource.data.ownerId == request.auth.uid;
      allow create: if isVerifiedUser()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.keys().hasAll(["ownerId", "filedDate", "name", "firstName", "middleName", "lastName", "office", "position", "salary", "leaveType", "leaveDetails", "specifyAbroad", "specifyIllness", "studyLeaveOtherPurpose", "workingDays", "inclusiveDateFrom", "inclusiveDateTo", "status", "createdAt"])
        && request.resource.data.keys().hasOnly(["ownerId", "filedDate", "name", "firstName", "middleName", "lastName", "office", "position", "salary", "leaveType", "leaveDetails", "specifyAbroad", "specifyIllness", "studyLeaveOtherPurpose", "workingDays", "inclusiveDateFrom", "inclusiveDateTo", "status", "createdAt"])
        && request.resource.data.filedDate is string
        && request.resource.data.filedDate.matches("^[0-9]{4}-[0-9]{2}-[0-9]{2}$")
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 183
        && request.resource.data.firstName is string
        && request.resource.data.firstName.size() > 0
        && request.resource.data.firstName.size() <= 60
        && request.resource.data.middleName is string
        && request.resource.data.middleName.size() <= 60
        && request.resource.data.lastName is string
        && request.resource.data.lastName.size() > 0
        && request.resource.data.lastName.size() <= 60
        && request.resource.data.name == request.resource.data.lastName + ", " + request.resource.data.firstName + (request.resource.data.middleName.size() > 0 ? " " + request.resource.data.middleName : "")
        && request.resource.data.office in ["FOD-AGRISTAT", "FOD-AMIA", "FOD-DRRM"]
        && request.resource.data.position is string
        && request.resource.data.position.size() > 0
        && request.resource.data.position.size() <= 120
        && request.resource.data.salary is string
        && request.resource.data.salary.size() > 0
        && request.resource.data.salary.size() <= 20
        && request.resource.data.leaveType in ["Vacation Leave", "Mandatory/Forced Leave", "Sick Leave", "Maternity Leave", "Paternity Leave", "Special Privilege Leave", "Solo Parent Leave", "Study Leave", "10-Day VAWC Leave", "Rehabilitation Privilege", "Special Leave Benefits for Women", "Special Emergency (Calamity) Leave", "Adoption Leave", "Others"]
        && request.resource.data.leaveDetails is string
        && request.resource.data.leaveDetails.size() <= 100
        && ((request.resource.data.leaveType == "Others" && request.resource.data.leaveDetails.size() > 0)
          || (request.resource.data.leaveType in ["Vacation Leave", "Special Privilege Leave"]
            && request.resource.data.leaveDetails in ["Within the Philippines", "Abroad"])
          || (request.resource.data.leaveType == "Sick Leave"
            && request.resource.data.leaveDetails in ["In Hospital", "Out Patient"])
          || (request.resource.data.leaveType == "Study Leave"
            && request.resource.data.leaveDetails in ["Completion of Master's Degree", "BAR/Board Examination Review", "Other Purpose"])
          || (request.resource.data.leaveType in ["Mandatory/Forced Leave", "Maternity Leave", "Paternity Leave", "Solo Parent Leave", "10-Day VAWC Leave", "Rehabilitation Privilege", "Special Leave Benefits for Women", "Special Emergency (Calamity) Leave", "Adoption Leave"]
            && request.resource.data.leaveDetails.size() == 0))
        && request.resource.data.specifyAbroad is string
        && request.resource.data.specifyAbroad.size() <= 120
        && ((request.resource.data.leaveType in ["Vacation Leave", "Special Privilege Leave"]
            && request.resource.data.leaveDetails == "Abroad"
            && request.resource.data.specifyAbroad.size() > 0)
          || (!(request.resource.data.leaveType in ["Vacation Leave", "Special Privilege Leave"]
              && request.resource.data.leaveDetails == "Abroad")
            && request.resource.data.specifyAbroad.size() == 0))
        && request.resource.data.specifyIllness is string
        && request.resource.data.specifyIllness.size() <= 120
        && ((request.resource.data.leaveType in ["Sick Leave", "Special Leave Benefits for Women"]
            && request.resource.data.specifyIllness.size() > 0)
          || (!(request.resource.data.leaveType in ["Sick Leave", "Special Leave Benefits for Women"])
            && request.resource.data.specifyIllness.size() == 0))
        && request.resource.data.studyLeaveOtherPurpose is string
        && ((request.resource.data.leaveType == "Study Leave"
            && request.resource.data.leaveDetails == "Other Purpose"
            && request.resource.data.studyLeaveOtherPurpose in ["Monetization of Leave Credits", "Terminal Leave"])
          || ((request.resource.data.leaveType != "Study Leave" || request.resource.data.leaveDetails != "Other Purpose")
            && request.resource.data.studyLeaveOtherPurpose == ""))
        && request.resource.data.workingDays is number
        && request.resource.data.workingDays > 0
        && request.resource.data.workingDays <= 365
        && request.resource.data.inclusiveDateFrom is string
        && request.resource.data.inclusiveDateFrom.matches("^[0-9]{4}-[0-9]{2}-[0-9]{2}$")
        && request.resource.data.inclusiveDateTo is string
        && request.resource.data.inclusiveDateTo.matches("^[0-9]{4}-[0-9]{2}-[0-9]{2}$")
        && request.resource.data.inclusiveDateTo >= request.resource.data.inclusiveDateFrom
        && request.resource.data.status == "Pending"
        && request.resource.data.createdAt is timestamp;
      allow update: if isVerifiedUser()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status"])
        && request.resource.data.status in ["Pending", "Approved", "Disapproved"];
      allow delete: if isVerifiedUser() && resource.data.ownerId == request.auth.uid;
    }
    match /approvedLeaveCalendar/{leaveApplicationId} {
      function matchesApprovedApplication(data) {
        let applicationPath = /databases/$(database)/documents/leaveApplications/$(leaveApplicationId);
        return existsAfter(applicationPath)
          && getAfter(applicationPath).data.ownerId == request.auth.uid
          && getAfter(applicationPath).data.status == data.status
          && getAfter(applicationPath).data.office == data.office
          && getAfter(applicationPath).data.leaveType == data.leaveType
          && getAfter(applicationPath).data.inclusiveDateFrom == data.inclusiveDateFrom
          && getAfter(applicationPath).data.inclusiveDateTo == data.inclusiveDateTo
          && ((!getAfter(applicationPath).data.keys().hasAll(["firstName", "lastName"]))
            || (getAfter(applicationPath).data.firstName == data.firstName
              && getAfter(applicationPath).data.lastName == data.lastName));
      }
      allow read: if isVerifiedUser() && resource.data.status in ["Approved", "Pending"];
      allow create, update: if isVerifiedUser()
        && request.resource.data.keys().hasAll(["leaveApplicationId", "ownerId", "status", "firstName", "middleInitial", "lastName", "office", "leaveType", "inclusiveDateFrom", "inclusiveDateTo"])
        && request.resource.data.keys().hasOnly(["leaveApplicationId", "ownerId", "status", "firstName", "middleInitial", "lastName", "office", "leaveType", "inclusiveDateFrom", "inclusiveDateTo"])
        && request.resource.data.leaveApplicationId == leaveApplicationId
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.status in ["Approved", "Pending"]
        && request.resource.data.firstName is string
        && request.resource.data.firstName.size() > 0
        && request.resource.data.firstName.size() <= 60
        && request.resource.data.middleInitial is string
        && request.resource.data.middleInitial.size() <= 8
        && (request.resource.data.middleInitial == "" || (request.resource.data.middleInitial.size() >= 2 && request.resource.data.middleInitial.matches("^.{1,7}[.]$")))
        && request.resource.data.lastName is string
        && request.resource.data.lastName.size() > 0
        && request.resource.data.lastName.size() <= 60
        && request.resource.data.office in ["FOD-AGRISTAT", "FOD-AMIA", "FOD-DRRM"]
        && request.resource.data.leaveType is string
        && request.resource.data.leaveType.size() > 0
        && request.resource.data.leaveType.size() <= 100
        && request.resource.data.inclusiveDateFrom is string
        && request.resource.data.inclusiveDateFrom.matches("^[0-9]{4}-[0-9]{2}-[0-9]{2}$")
        && request.resource.data.inclusiveDateTo is string
        && request.resource.data.inclusiveDateTo.matches("^[0-9]{4}-[0-9]{2}-[0-9]{2}$")
        && request.resource.data.inclusiveDateTo >= request.resource.data.inclusiveDateFrom
        && matchesApprovedApplication(request.resource.data);
      allow delete: if isVerifiedUser()
        && resource.data.status in ["Approved", "Pending"]
        && resource.data.ownerId == request.auth.uid
        && resource.data.leaveApplicationId == leaveApplicationId
        && resource.data.leaveApplicationId is string
        && (!existsAfter(/databases/$(database)/documents/leaveApplications/$(resource.data.leaveApplicationId))
          || !(getAfter(/databases/$(database)/documents/leaveApplications/$(resource.data.leaveApplicationId)).data.status in ["Approved", "Pending"]));
    }
    match /travelOrders/{travelOrderId} {
      allow read: if isVerifiedUser() && (resource.data.ownerId == request.auth.uid || resource.data.status in ["Approved", "Pending", "Processing"]);
      allow create: if isVerifiedUser() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isVerifiedUser() && resource.data.ownerId == request.auth.uid;
    }
    match /travelOrderNumbers/{numberId} {
      allow get: if isVerifiedUser();
      allow list: if false;
      allow create: if isVerifiedUser()
        && request.resource.data.keys().hasAll(["ownerId", "travelOrderId"])
        && request.resource.data.keys().hasOnly(["ownerId", "travelOrderId"])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.travelOrderId is string
        && get(/databases/$(database)/documents/travelOrders/$(request.resource.data.travelOrderId)).data.ownerId == request.auth.uid
        && getAfter(/databases/$(database)/documents/travelOrders/$(request.resource.data.travelOrderId)).data.status == "Approved";
      allow update: if false;
      allow delete: if isVerifiedUser()
        && resource.data.ownerId == request.auth.uid
        && resource.data.travelOrderId is string
        && get(/databases/$(database)/documents/travelOrders/$(resource.data.travelOrderId)).data.ownerId == request.auth.uid
        && !existsAfter(/databases/$(database)/documents/travelOrders/$(resource.data.travelOrderId));
    }
    match /ntaRecords/{ntaId} {
      allow read: if isVerifiedUser() && resource.data.ownerId == request.auth.uid;
      allow create: if isVerifiedUser() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isVerifiedUser() && resource.data.ownerId == request.auth.uid;
    }
    match /myNotes/{noteId} {
      allow read: if isVerifiedUser() && resource.data.ownerId == request.auth.uid;
      allow create: if isVerifiedUser()
        && request.resource.data.keys().hasAll(["ownerId", "date", "task", "status", "remarks", "order", "createdAt"])
        && request.resource.data.keys().hasOnly(["ownerId", "date", "task", "status", "remarks", "order", "createdAt"])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.date is string
        && request.resource.data.date.matches("^[0-9]{4}-[0-9]{2}-[0-9]{2}$")
        && request.resource.data.task is string
        && request.resource.data.task.size() > 0
        && request.resource.data.task.size() <= 1200
        && request.resource.data.status == "Pending"
        && request.resource.data.remarks is string
        && request.resource.data.remarks.size() <= 1200
        && request.resource.data.order is int
        && request.resource.data.order >= 0
        && request.resource.data.createdAt is timestamp;
      allow update: if isVerifiedUser()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["task", "status", "remarks", "order"])
        && request.resource.data.keys().hasAll(["ownerId", "date", "task", "status", "remarks", "order", "createdAt"])
        && request.resource.data.keys().hasOnly(["ownerId", "date", "task", "status", "remarks", "order", "createdAt"])
        && request.resource.data.task is string
        && request.resource.data.task.size() > 0
        && request.resource.data.task.size() <= 1200
        && request.resource.data.status in ["Pending", "Done"]
        && request.resource.data.remarks is string
        && request.resource.data.remarks.size() <= 1200
        && request.resource.data.order is int
        && request.resource.data.order >= 0;
      allow delete: if false;
    }
    match /accomplishmentReports/{reportId} {
      allow read: if isVerifiedUser() && resource.data.ownerId == request.auth.uid;
      allow create: if isVerifiedUser()
        && request.resource.data.ownerId == request.auth.uid
        && reportId == request.auth.uid + "_" + request.resource.data.month + (request.resource.data.cycle == 1 ? "_first" : "_second")
        && request.resource.data.keys().hasAll(["ownerId", "month", "cycle", "startDay", "endDay", "activities", "unit", "preparedName", "preparedPosition", "createdAt"])
        && request.resource.data.keys().hasOnly(["ownerId", "month", "cycle", "startDay", "endDay", "activities", "unit", "preparedName", "preparedPosition", "createdAt"])
        && request.resource.data.month is string
        && request.resource.data.month.size() == 7
        && ((request.resource.data.cycle == 1
          && request.resource.data.startDay == 1
          && request.resource.data.endDay == 15)
          || (request.resource.data.cycle == 2
          && request.resource.data.startDay == 16
          && request.resource.data.endDay >= 28
          && request.resource.data.endDay <= 31))
        && request.resource.data.activities is list
        && request.resource.data.activities.size() > 0
        && request.resource.data.activities.size() <= 30
        && request.resource.data.unit in ["AMIA", "AGRISTAT", "DRRM"]
        && request.resource.data.preparedName is string
        && request.resource.data.preparedName.size() > 0
        && request.resource.data.preparedName.size() <= 120
        && request.resource.data.preparedPosition is string
        && request.resource.data.preparedPosition.size() > 0
        && request.resource.data.preparedPosition.size() <= 120
        && request.resource.data.createdAt is timestamp;
      allow update: if isVerifiedUser()
        && resource.data.ownerId == request.auth.uid
        && isAccomplishmentReportEditable(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasAny(["activities"])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["activities"])
        && request.resource.data.activities is list
        && request.resource.data.activities.size() > 0
        && request.resource.data.activities.size() <= 30;
      allow delete: if false;
    }
  }
}
