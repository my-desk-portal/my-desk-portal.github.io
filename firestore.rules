rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isVerifiedUser() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function isPermitAdmin() {
      return isVerifiedUser()
        && request.auth.token.email in ["gerlieantipaso27@gmail.com", "rjamescute2@gmail.com"];
    }
    match /users/{userId} {
      allow read: if isVerifiedUser() && request.auth.uid == userId;
      // New accounts must save their profile before email verification; only the same UID can write it.
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasAll(["name", "position", "unit"])
        && request.resource.data.keys().hasOnly(["name", "position", "unit"])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.position is string
        && request.resource.data.position.size() <= 120
        && request.resource.data.unit in ["AMIA", "AGRISTAT", "DRRM"];
      allow delete: if false;
    }
    match /permits/{permitId} {
      allow read: if isVerifiedUser() && (resource.data.ownerId == request.auth.uid || isPermitAdmin());
      allow create: if isVerifiedUser()
        && request.resource.data.ownerId == request.auth.uid
        && !request.resource.data.keys().hasAny(["personStatuses"]);
      allow update: if isVerifiedUser() && (
        (resource.data.ownerId == request.auth.uid
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(["personStatuses"]))
        || (isPermitAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["personStatuses"])
          && request.resource.data.personStatuses is map)
      );
      allow delete: if isVerifiedUser() && resource.data.ownerId == request.auth.uid;
    }
    match /permitCounters/{counterId} {
      allow read, write: if isVerifiedUser();
    }
    match /approvedPermitCalendar/{entryId} {
      allow read: if isVerifiedUser();
      allow create, update: if isPermitAdmin()
        && request.resource.data.keys().hasAll(["permitId", "statusKey", "status", "permitNo", "name", "date", "purpose", "unit"])
        && request.resource.data.keys().hasOnly(["permitId", "statusKey", "status", "permitNo", "name", "date", "purpose", "unit"])
        && request.resource.data.permitId is string
        && request.resource.data.statusKey is string
        && request.resource.data.status == "Approved"
        && getAfter(/databases/$(database)/documents/permits/$(request.resource.data.permitId)).data.personStatuses[request.resource.data.statusKey].status == "Approved";
      allow delete: if isPermitAdmin();
    }
    match /specialOrders/{orderId} {
      allow read: if isVerifiedUser() && resource.data.ownerId == request.auth.uid;
      allow create: if isVerifiedUser() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isVerifiedUser() && resource.data.ownerId == request.auth.uid;
    }
    match /certificatesOfAppearance/{certificateId} {
      allow read, update, delete: if isVerifiedUser() && resource.data.ownerId == request.auth.uid;
      allow create: if isVerifiedUser()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.keys().hasAll(["eventTitle", "destination", "eventDateFrom", "eventDateTo", "people", "signatoryName", "designation", "division", "ownerId", "createdAt"])
        && request.resource.data.keys().hasOnly(["eventTitle", "destination", "eventDateFrom", "eventDateTo", "people", "signatoryName", "designation", "division", "ownerId", "createdAt"])
        && request.resource.data.eventTitle is string
        && request.resource.data.destination is string
        && request.resource.data.eventDateFrom is string
        && request.resource.data.eventDateTo is string
        && request.resource.data.people is list
        && request.resource.data.people.size() > 0
        && request.resource.data.people.size() <= 100
        && request.resource.data.signatoryName is string
        && request.resource.data.designation is string
        && request.resource.data.division is string
        && request.resource.data.createdAt is timestamp;
    }
    match /appreciationCertificates/{certificateId} {
      allow read: if isVerifiedUser() && resource.data.ownerId == request.auth.uid;
      allow create: if isVerifiedUser()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.keys().hasAll(["unit", "speakerName", "speakerGender", "speakerPosition", "speakerOffice", "eventTitle", "eventDateFrom", "eventDateTo", "eventTimeFrom", "eventTimeTo", "eventDestination", "distributionSameAsDestination", "distributionPlace", "ownerId", "createdAt"])
        && request.resource.data.keys().hasOnly(["unit", "speakerName", "speakerGender", "speakerPosition", "speakerOffice", "eventTitle", "eventDateFrom", "eventDateTo", "eventTimeFrom", "eventTimeTo", "eventDestination", "distributionSameAsDestination", "distributionPlace", "ownerId", "createdAt"])
        && request.resource.data.unit == "DRRM"
        && request.resource.data.speakerName is string
        && request.resource.data.speakerName.size() > 0
        && request.resource.data.speakerName.size() <= 180
        && request.resource.data.speakerGender in ["female", "male"]
        && request.resource.data.speakerPosition is string
        && request.resource.data.speakerPosition.size() > 0
        && request.resource.data.speakerPosition.size() <= 180
        && request.resource.data.speakerOffice is string
        && request.resource.data.speakerOffice.size() > 0
        && request.resource.data.speakerOffice.size() <= 240
        && request.resource.data.eventTitle is string
        && request.resource.data.eventTitle.size() > 0
        && request.resource.data.eventTitle.size() <= 240
        && request.resource.data.eventDateFrom is string
        && request.resource.data.eventDateFrom.size() > 0
        && request.resource.data.eventDateTo is string
        && request.resource.data.eventDateTo.size() > 0
        && request.resource.data.eventTimeFrom is string
        && request.resource.data.eventTimeFrom.size() > 0
        && request.resource.data.eventTimeTo is string
        && request.resource.data.eventTimeTo.size() > 0
        && request.resource.data.eventDestination is string
        && request.resource.data.eventDestination.size() > 0
        && request.resource.data.eventDestination.size() <= 240
        && request.resource.data.distributionSameAsDestination is bool
        && request.resource.data.distributionPlace is string
        && request.resource.data.distributionPlace.size() > 0
        && request.resource.data.distributionPlace.size() <= 240
        && (!request.resource.data.distributionSameAsDestination || request.resource.data.distributionPlace == request.resource.data.eventDestination)
        && request.resource.data.createdAt is timestamp;
      allow update, delete: if false;
    }
    match /completionCertificates/{certificateId} {
      allow read: if isVerifiedUser() && resource.data.ownerId == request.auth.uid;
      allow create: if isVerifiedUser()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.keys().hasAll(["unit", "participantNames", "eventTitle", "eventDateFrom", "eventDateTo", "eventTimeFrom", "eventTimeTo", "eventDestination", "distributionSameAsDestination", "distributionPlace", "ownerId", "createdAt"])
        && request.resource.data.keys().hasOnly(["unit", "participantNames", "eventTitle", "eventDateFrom", "eventDateTo", "eventTimeFrom", "eventTimeTo", "eventDestination", "distributionSameAsDestination", "distributionPlace", "ownerId", "createdAt"])
        && request.resource.data.unit == "DRRM"
        && request.resource.data.participantNames is list
        && request.resource.data.participantNames.size() > 0
        && request.resource.data.participantNames.size() <= 100
        && request.resource.data.eventTitle is string
        && request.resource.data.eventTitle.size() > 0
        && request.resource.data.eventTitle.size() <= 240
        && request.resource.data.eventDateFrom is string
        && request.resource.data.eventDateTo is string
        && request.resource.data.eventTimeFrom is string
        && request.resource.data.eventTimeTo is string
        && request.resource.data.eventDestination is string
        && request.resource.data.eventDestination.size() > 0
        && request.resource.data.eventDestination.size() <= 240
        && request.resource.data.distributionSameAsDestination is bool
        && request.resource.data.distributionPlace is string
        && request.resource.data.distributionPlace.size() > 0
        && request.resource.data.distributionPlace.size() <= 240
        && (!request.resource.data.distributionSameAsDestination || request.resource.data.distributionPlace == request.resource.data.eventDestination)
        && request.resource.data.createdAt is timestamp;
      allow update: if isVerifiedUser()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasAny(["participantNames"])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["participantNames"])
        && request.resource.data.participantNames is list
        && request.resource.data.participantNames.size() > 0
        && request.resource.data.participantNames.size() <= 100;
      allow delete: if false;
    }
    match /travelOrders/{travelOrderId} {
      allow read: if isVerifiedUser() && (resource.data.ownerId == request.auth.uid || resource.data.status == "Approved");
      allow create: if isVerifiedUser() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isVerifiedUser() && resource.data.ownerId == request.auth.uid;
    }
    match /travelOrderNumbers/{numberId} {
      allow get: if isVerifiedUser();
      allow list: if false;
      allow create: if isVerifiedUser()
        && request.resource.data.keys().hasAll(["ownerId", "travelOrderId"])
        && request.resource.data.keys().hasOnly(["ownerId", "travelOrderId"])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.travelOrderId is string
        && get(/databases/$(database)/documents/travelOrders/$(request.resource.data.travelOrderId)).data.ownerId == request.auth.uid
        && getAfter(/databases/$(database)/documents/travelOrders/$(request.resource.data.travelOrderId)).data.status == "Approved";
      allow update, delete: if false;
    }
    match /ntaRecords/{ntaId} {
      allow read: if isVerifiedUser() && resource.data.ownerId == request.auth.uid;
      allow create: if isVerifiedUser() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isVerifiedUser() && resource.data.ownerId == request.auth.uid;
    }
    match /accomplishmentReports/{reportId} {
      allow read: if isVerifiedUser() && resource.data.ownerId == request.auth.uid;
      allow create: if isVerifiedUser()
        && request.resource.data.ownerId == request.auth.uid
        && reportId == request.auth.uid + "_" + request.resource.data.month + (request.resource.data.cycle == 1 ? "_first" : "_second")
        && request.resource.data.keys().hasAll(["ownerId", "month", "cycle", "startDay", "endDay", "activities", "unit", "preparedName", "preparedPosition", "createdAt"])
        && request.resource.data.keys().hasOnly(["ownerId", "month", "cycle", "startDay", "endDay", "activities", "unit", "preparedName", "preparedPosition", "createdAt"])
        && request.resource.data.month is string
        && request.resource.data.month.size() == 7
        && ((request.resource.data.cycle == 1
          && request.resource.data.startDay == 1
          && request.resource.data.endDay == 15)
          || (request.resource.data.cycle == 2
          && request.resource.data.startDay == 16
          && request.resource.data.endDay >= 28
          && request.resource.data.endDay <= 31))
        && request.resource.data.activities is list
        && request.resource.data.activities.size() > 0
        && request.resource.data.activities.size() <= 30
        && request.resource.data.unit in ["AMIA", "AGRISTAT", "DRRM"]
        && request.resource.data.preparedName is string
        && request.resource.data.preparedName.size() > 0
        && request.resource.data.preparedName.size() <= 120
        && request.resource.data.preparedPosition is string
        && request.resource.data.preparedPosition.size() > 0
        && request.resource.data.preparedPosition.size() <= 120
        && request.resource.data.createdAt is timestamp;
      allow update: if isVerifiedUser()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasAny(["activities"])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["activities"])
        && request.resource.data.activities is list
        && request.resource.data.activities.size() > 0
        && request.resource.data.activities.size() <= 30;
      allow delete: if false;
    }
  }
}
