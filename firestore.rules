rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /permits/{permitId} {
      allow read: if request.auth != null && resource.data.ownerId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }
    match /permitCounters/{counterId} {
      allow read, write: if request.auth != null;
    }
    match /specialOrders/{orderId} {
      allow read: if request.auth != null && resource.data.ownerId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }
    match /travelOrders/{travelOrderId} {
      allow read: if request.auth != null && (resource.data.ownerId == request.auth.uid || resource.data.status == "Approved");
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }
    match /travelOrderNumbers/{numberId} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(["ownerId", "travelOrderId"])
        && request.resource.data.keys().hasOnly(["ownerId", "travelOrderId"])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.travelOrderId is string
        && get(/databases/$(database)/documents/travelOrders/$(request.resource.data.travelOrderId)).data.ownerId == request.auth.uid
        && getAfter(/databases/$(database)/documents/travelOrders/$(request.resource.data.travelOrderId)).data.status == "Approved";
      allow update, delete: if false;
    }
    match /ntaRecords/{ntaId} {
      allow read: if request.auth != null && resource.data.ownerId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }
  }
}
